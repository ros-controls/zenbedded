menu "Sine Wave Zephyr Demo"

choice SINE_WAVE_COMM_INTERFACE
    prompt "Communication Transport Interface"
    default SINE_WAVE_COMM_USB_CDC
    help
      Select the physical transport used to connect the Sine Wave
      microcontroller to the Zenoh network / Host PC.

    config SINE_WAVE_COMM_WIFI
        bool "Wi-Fi Interface"
        select WIFI
        select WIFI_NM
        select WIFI_CREDENTIALS
        select WIFI_CREDENTIALS_CONNECT_STORED
        select NET_L2_WIFI_SHELL
        select WIFI_CREDENTIALS_SHELL
        select NET_DHCPV4
        help
          Connect to the Zenoh network over 802.11 Wi-Fi station mode using
          stored credentials.

    config SINE_WAVE_COMM_USB_CDC
        bool "USB CDC (Ethernet) Interface"
        select USB_DEVICE_STACK_NEXT
        select NET_L2_ETHERNET
        select USBD_CDC_ECM_CLASS
        help
          Connect to the Zenoh network over USB CDC ECM (Ethernet emulation)
          for low-latency, jitter-free wired communication.

endchoice

config WIFI_ESP32
    default y if SINE_WAVE_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

config ESP32_WIFI_STA_AUTO_DHCPV4
    default y if SINE_WAVE_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

config ESP32_WIFI_STA_RECONNECT
    default y if SINE_WAVE_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

if SINE_WAVE_COMM_USB_CDC

    config SINE_WAVE_USB_CDC_STATIC_IP
        bool "Configure static IPv4 address on USB CDC interface"
        default y
        select NET_CONFIG_SETTINGS
        help
          Configure a deterministic static IPv4 address for the USB CDC interface
          so a DHCP server is not required on the host PC.

    config SINE_WAVE_USB_CDC_MY_IPV4_ADDR
        string "Device USB CDC IPv4 address"
        depends on SINE_WAVE_USB_CDC_STATIC_IP
        default "192.0.2.2"
        help
          IPv4 address assigned to the ESP32-S3 USB CDC interface.

    config SINE_WAVE_USB_CDC_PEER_IPV4_ADDR
        string "Host PC USB CDC IPv4 address"
        depends on SINE_WAVE_USB_CDC_STATIC_IP
        default "192.0.2.1"
        help
          IPv4 address of the host machine on the USB CDC link.

    config SINE_WAVE_USB_CDC_NETMASK
        string "Device USB CDC IPv4 Netmask"
        depends on SINE_WAVE_USB_CDC_STATIC_IP
        default "255.255.255.0"
        help
          IPv4 netmask of the USB CDC interface.

    config NET_CONFIG_MY_IPV4_ADDR
        default SINE_WAVE_USB_CDC_MY_IPV4_ADDR if SINE_WAVE_USB_CDC_STATIC_IP

    config NET_CONFIG_PEER_IPV4_ADDR
        default SINE_WAVE_USB_CDC_PEER_IPV4_ADDR if SINE_WAVE_USB_CDC_STATIC_IP

    config NET_CONFIG_MY_IPV4_NETMASK
        default SINE_WAVE_USB_CDC_NETMASK if SINE_WAVE_USB_CDC_STATIC_IP

    config SAMPLE_USBD_PRODUCT
        default "Sine Wave Zephyr"

    config SAMPLE_USBD_MANUFACTURER
        default "Open Source Robotics Foundation"

    config SINE_WAVE_USB_CDC_DHCPV4_SERVER
        bool "Run DHCPv4 server on USB CDC interface"
        default y
        depends on SINE_WAVE_USB_CDC_STATIC_IP
        select NET_DHCPV4_SERVER
        select NET_UDP
        help
          Runs a lightweight DHCPv4 server leasing the peer IPv4 address to the
          connected host PC, enabling true zero-configuration plug-and-play.

    config NET_DHCPV4_SERVER_ADDR_COUNT
        default 1 if SINE_WAVE_USB_CDC_DHCPV4_SERVER

    config NET_DHCPV4_SERVER_ICMP_PROBE_TIMEOUT
        default 0 if SINE_WAVE_USB_CDC_DHCPV4_SERVER

    config NET_DHCPV4_SERVER_OPTION_ROUTER
        default n if SINE_WAVE_USB_CDC_DHCPV4_SERVER

endif # SINE_WAVE_COMM_USB_CDC

config ZENBEDDED_ZENOH_IP_PORT
    default "192.0.2.1:7447" if SINE_WAVE_COMM_USB_CDC
    default "10.75.105.128:7447" if SINE_WAVE_COMM_WIFI

endmenu

if USB_DEVICE_STACK_NEXT
source "samples/subsys/usb/common/Kconfig.sample_usbd"
endif

source "Kconfig.zephyr"
