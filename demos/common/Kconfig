menuconfig ZENBEDDED_DEMO_COMMON
    bool "Zenbedded Demo Common Infrastructure"
    default y
    help
      Shared infrastructure for Zenbedded demo applications (USB CDC Ethernet,
      Wi-Fi station bringup, logging stack hardening, and DHCPv4 server).

if ZENBEDDED_DEMO_COMMON

choice ZENBEDDED_DEMO_COMM_INTERFACE
    prompt "Demo Communication Transport Interface"
    default ZENBEDDED_DEMO_COMM_USB_CDC
    help
      Select the physical transport used to connect the MCU to the Zenoh network / Host PC.

    config ZENBEDDED_DEMO_COMM_USB_CDC
        bool "USB CDC (Ethernet) Interface"
        select USB_DEVICE_STACK_NEXT
        select NET_L2_ETHERNET
        select USBD_CDC_ECM_CLASS
        help
          Connect over USB CDC ECM (Ethernet emulation) for low-latency wired communication.

    config ZENBEDDED_DEMO_COMM_WIFI
        bool "Wi-Fi Interface"
        select WIFI
        select WIFI_NM
        select WIFI_CREDENTIALS
        select WIFI_CREDENTIALS_CONNECT_STORED
        select NET_L2_WIFI_SHELL
        select WIFI_CREDENTIALS_SHELL
        select NET_DHCPV4
        help
          Connect over 802.11 Wi-Fi station mode using stored credentials.

endchoice

# Backward-compatibility aliases for existing code checking legacy symbols
config INVERTED_PENDULUM_COMM_USB_CDC
    bool
    default y if ZENBEDDED_DEMO_COMM_USB_CDC

config INVERTED_PENDULUM_COMM_WIFI
    bool
    default y if ZENBEDDED_DEMO_COMM_WIFI

config SINE_WAVE_COMM_USB_CDC
    bool
    default y if ZENBEDDED_DEMO_COMM_USB_CDC

config SINE_WAVE_COMM_WIFI
    bool
    default y if ZENBEDDED_DEMO_COMM_WIFI

# Conditional Wi-Fi enablement on ESP32
config WIFI_ESP32
    default y if ZENBEDDED_DEMO_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

config ESP32_WIFI_STA_AUTO_DHCPV4
    default y if ZENBEDDED_DEMO_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

config ESP32_WIFI_STA_RECONNECT
    default y if ZENBEDDED_DEMO_COMM_WIFI && SOC_FAMILY_ESPRESSIF_ESP32

if ZENBEDDED_DEMO_COMM_USB_CDC

    config ZENBEDDED_DEMO_USB_CDC_STATIC_IP
        bool "Configure static IPv4 address on USB CDC interface"
        default y
        select NET_CONFIG_SETTINGS
        help
          Configure deterministic static IPv4 address for the USB CDC interface.

    config ZENBEDDED_DEMO_USB_CDC_MY_IPV4_ADDR
        string "Device USB CDC IPv4 address"
        depends on ZENBEDDED_DEMO_USB_CDC_STATIC_IP
        default "192.0.2.2"

    config ZENBEDDED_DEMO_USB_CDC_PEER_IPV4_ADDR
        string "Host PC USB CDC IPv4 address"
        depends on ZENBEDDED_DEMO_USB_CDC_STATIC_IP
        default "192.0.2.1"

    config ZENBEDDED_DEMO_USB_CDC_NETMASK
        string "Device USB CDC IPv4 Netmask"
        depends on ZENBEDDED_DEMO_USB_CDC_STATIC_IP
        default "255.255.255.0"

    config NET_CONFIG_MY_IPV4_ADDR
        default ZENBEDDED_DEMO_USB_CDC_MY_IPV4_ADDR if ZENBEDDED_DEMO_USB_CDC_STATIC_IP

    config NET_CONFIG_PEER_IPV4_ADDR
        default ZENBEDDED_DEMO_USB_CDC_PEER_IPV4_ADDR if ZENBEDDED_DEMO_USB_CDC_STATIC_IP

    config NET_CONFIG_MY_IPV4_NETMASK
        default ZENBEDDED_DEMO_USB_CDC_NETMASK if ZENBEDDED_DEMO_USB_CDC_STATIC_IP

    config ZENBEDDED_DEMO_USBD_VID
        hex "USB device Vendor ID"
        default 0x303a if SOC_FAMILY_ESPRESSIF_ESP32
        default 0x2fe3
        help
          USB device Vendor ID (VID). Default is Espressif (0x303a) or Zephyr (0x2fe3).

    config ZENBEDDED_DEMO_USBD_PID
        hex "USB device Product ID"
        default 0x0001
        help
          USB device Product ID (PID).

    config ZENBEDDED_DEMO_USBD_MANUFACTURER
        string "USB device manufacturer string"
        default SAMPLE_USBD_MANUFACTURER if SAMPLE_USBD_MANUFACTURER != ""
        default "Open Source Robotics Foundation"

    config ZENBEDDED_DEMO_USBD_PRODUCT
        string "USB device product string"
        default SAMPLE_USBD_PRODUCT if SAMPLE_USBD_PRODUCT != ""
        default "Zenbedded Demo"

    config ZENBEDDED_DEMO_USBD_MAX_POWER
        int "USB device max power consumption (2mA units)"
        default 125
        help
          Maximum power in 2mA units (125 = 250mA).

    # Backward compatibility aliases
    config SAMPLE_USBD_PRODUCT
        string "USB product string (legacy alias)"
        default ""

    config SAMPLE_USBD_MANUFACTURER
        string "USB manufacturer string (legacy alias)"
        default ""

    config ZENBEDDED_DEMO_USB_CDC_DHCPV4_SERVER
        bool "Run DHCPv4 server on USB CDC interface"
        default y
        depends on ZENBEDDED_DEMO_USB_CDC_STATIC_IP
        select NET_DHCPV4_SERVER
        select NET_UDP
        help
          Leases peer IPv4 address to host PC for zero-config plug-and-play.

    config NET_DHCPV4_SERVER_ADDR_COUNT
        default 1 if ZENBEDDED_DEMO_USB_CDC_DHCPV4_SERVER

    config NET_DHCPV4_SERVER_ICMP_PROBE_TIMEOUT
        default 0 if ZENBEDDED_DEMO_USB_CDC_DHCPV4_SERVER

    config NET_DHCPV4_SERVER_OPTION_ROUTER
        default n if ZENBEDDED_DEMO_USB_CDC_DHCPV4_SERVER

endif # ZENBEDDED_DEMO_COMM_USB_CDC

# Logging stack hardening defaults
config LOG_PROCESS_THREAD_STACK_SIZE
    default 4096 if LOG

config LOG_BUFFER_SIZE
    default 4096 if LOG

config SHELL_BACKEND_SERIAL_LOG_MESSAGE_QUEUE_SIZE
    default 2048 if SHELL_BACKEND_SERIAL

config SHELL_STACK_SIZE
    default 3072 if SHELL

endif # ZENBEDDED_DEMO_COMMON
