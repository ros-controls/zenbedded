menu "Inverted Pendulum Tier 2 Demo"

config ENCODER_SAMPLING_THREAD_PRIORITY
    int "Priority for the magnetic encoder's sampling thread"
    default 0

config ZENBEDDED_ZENOH_LOCATOR
    string "Zenoh Target Locator"
    default "192.0.2.1:7447" if ZENBEDDED_COMMON_USB_CDC
    default "127.0.0.1:7447"
    help
      Network endpoint locator for the Zenoh router (e.g. 192.168.1.50:7447 or 192.0.2.1:7447).

endmenu

