<?xml version="1.0"?>
<!--
    Rotary inverted pendulum (Furuta), copied from
    https://github.com/ferrolho/rotary-inverted-pendulum/blob/main/model/model.urdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inverted_pendulum">
    <xacro:arg name="use_mock_hardware" default="false" />
    <xacro:arg name="tier" default="2" />
    <xacro:arg name="enable_kicking" default="true" />

    <material name="enclosure">
        <color rgba="0. 0.6 0.6 1" />
    </material>
    <material name="arm_color">
        <color rgba="0.25 0.25 0.28 1" />
    </material>
    <material name="pendulum_color">
        <color rgba="0.25 0.25 0.28 1" />
    </material>

    <!-- Base (fixed to the world origin) -->
    <link name="base">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://zenbedded_inverted_pendulum/meshes/base.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="enclosure" />
        </visual>
    </link>

    <link name="lid">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://zenbedded_inverted_pendulum/meshes/lid.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="enclosure" />
        </visual>
    </link>

    <joint name="base_to_lid" type="fixed">
        <parent link="base" />
        <child link="lid" />
        <origin xyz="0 0 0.070" rpy="0 0 0" />
    </joint>

    <link name="arm">
        <inertial>
            <origin
                xyz="0.041 0 0.011"
                rpy="0 0 0" />
            <mass value="0.026" />
            <inertia
                ixx="0.00000429"
                ixy="0"
                ixz="-0.00000175"
                iyy="0.00001756"
                iyz="0"
                izz="0.0000173" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://zenbedded_inverted_pendulum/meshes/arm.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="arm_color" />
        </visual>
    </link>

    <link name="pendulum">
        <inertial>
            <origin
                xyz="0 0 -0.051"
                rpy="0 0 0" />
            <mass value="0.014" />
            <inertia
                ixx="0.00000806"
                ixy="0"
                ixz="0"
                iyy="0.00000855"
                iyz="0.00000019"
                izz="0.00000061" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="3.14159265 0 -1.57079633" />
            <geometry>
                <mesh filename="package://zenbedded_inverted_pendulum/meshes/pendulum.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="pendulum_color" />
        </visual>
    </link>

    <joint name="motor_joint" type="revolute">
        <parent link="base" />
        <child link="arm" />
        <origin xyz="0 0 0.075" rpy="0 0 -1.57079" />
        <axis xyz="0 0 1" />
        <limit lower="-2.35619449" upper="2.35619449" effort="0.4" velocity="196" />
    </joint>

    <joint name="pendulum_joint" type="continuous">
        <parent link="arm" />
        <child link="pendulum" />
        <origin xyz="0.062 0 0.014" rpy="3.14 0 0" />
        <axis xyz="1 0 0" />
    </joint>

    <ros2_control name="ZenbeddedSystem" type="system">
        <xacro:if value="$(arg use_mock_hardware)">
            <hardware>
                <plugin>mock_pendulum_hardware/MockPendulumHardware</plugin>

                <!-- CAD-derived plant parameters -->
                <param name="J1">6.10e-5</param>       <!-- arm inertia about motor axis [kg*m^2] -->
                <param name="J2">4.447e-5</param>      <!-- pendulum inertia about hinge [kg*m^2] -->
                <param name="m2">0.014</param>         <!-- pendulum mass [kg] -->
                <param name="l2">0.051</param>         <!-- hinge to pendulum COM [m] -->
                <param name="L1">0.062</param>         <!-- motor axis to hinge [m] -->
                <param name="b1">1.0e-4</param>        <!-- arm viscous friction [N*m*s/rad] -->
                <param name="b2">8.0e-6</param>        <!-- pendulum viscous friction [N*m*s/rad] -->
                <param name="c2">2.0e-6</param>        <!-- pendulum Coulomb friction [N*m] -->
                <param name="g">9.80665</param>

                <!-- Actuator limits -->
                <param name="motor_position_limit">2.35619449</param>  <!-- +-135 deg hard stops [rad] -->
                <param name="motor_max_velocity">7.0</param>
                <param name="motor_max_acceleration">200.0</param>
                <param name="motor_max_torque">0.6</param>
                <param name="model_step_loss">false</param>
                <param name="hard_stop_restitution">0.0</param>

                <!-- Sensor quantization and filtering -->
                <param name="motor_steps_per_rev">3200</param>
                <param name="encoder_counts_per_rev">4096</param>
                <param name="encoder_noise">0.0002</param>
                <param name="pendulum_velocity_from_encoder">false</param>
                <param name="velocity_filter_alpha">0.95</param>
                <param name="pendulum_report_offset">0.0</param>

                <!-- Controlled physical randomness (subtle realism, not overboard) -->
                <param name="pendulum_accel_noise">0.005</param>
                <param name="motor_accel_noise">0.005</param>
                <param name="param_randomization">0.005</param>
                <!-- 0.1 rad (~5.7 deg) initial angle allows master's PD balance controller to stabilize -->
                <param name="initial_q2">0.1</param>
                <param name="initial_q2_jitter">0.002</param>
                <param name="seed">0</param>

                <!-- Timing -->
                <param name="sim_speed_factor">1.0</param>
                <param name="max_substep">5.0e-4</param>

                <!-- Periodic disturbance kicks -->
                <param name="kick_enable">$(arg enable_kicking)</param>
                <param name="first_kick_delay">3.0</param>
                <param name="kick_interval_mean">4.0</param>
                <param name="kick_interval_jitter">1.0</param>
                <param name="kick_magnitude_min">1.8</param>
                <param name="kick_magnitude_max">3.5</param>
                <param name="topple_kick_chance">0.25</param>
                <param name="topple_magnitude_min">5.5</param>
                <param name="topple_magnitude_max">8.0</param>
            </hardware>
        </xacro:if>
        <xacro:unless value="$(arg use_mock_hardware)">
            <xacro:if value="${'$(arg tier)' == '1'}">
                <hardware>
                    <plugin>zenbedded_inverted_pendulum/InvertedPendulumTier1Hardware</plugin>
                    <param name="state_topic">/zenbedded/inverted_pendulum/state</param>
                    <param name="command_topic">/zenbedded/inverted_pendulum/cmd</param>
                </hardware>
            </xacro:if>
            <xacro:unless value="${'$(arg tier)' == '1'}">
                <hardware>
                    <plugin>zenbedded_hardware_interface/ZenbeddedHardware</plugin>
                    <param name="schema_path">$(find zenbedded_inverted_pendulum)/config/interface_schema.yaml</param>
                    <param name="zenoh_mode">client</param>
                    <param name="zenoh_endpoint">tcp/127.0.0.1:7447</param>
                    <param name="state_topic">zenbedded/inverted_pendulum/state</param>
                    <param name="command_topic">zenbedded/inverted_pendulum/cmd</param>
                </hardware>
            </xacro:unless>
        </xacro:unless>

        <joint name="motor_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="acceleration"/>
        </joint>
        <joint name="pendulum_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>
