<?xml version="1.0"?>
<robot name="inverted_pendulum_mock">
    <link name="base_link"/>
    <link name="motor_joint_link"/>
    <link name="pendulum_link"/>

    <joint name="motor_joint" type="continuous">
        <parent link="base_link"/>
        <child link="motor_joint_link"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="pendulum_joint" type="continuous">
        <parent link="motor_joint_link"/>
        <child link="pendulum_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0.2 0 0" rpy="0 0 0"/>
    </joint>

    <ros2_control name="MockPendulumSystem" type="system">
        <hardware>
            <plugin>mock_pendulum_hardware/MockPendulumHardware</plugin>

            <!-- Plant (defaults are the CAD values; every parameter is optional) -->
            <param name="J1">6.10e-5</param>       <!-- arm inertia about motor axis -->
            <param name="J2">4.447e-5</param>      <!-- pendulum inertia about the HINGE -->
            <param name="m2">0.014</param>
            <param name="l2">0.051</param>
            <param name="L1">0.062</param>         <!-- arm reach, motor axis -> hinge -->
            <param name="b1">1.0e-4</param>
            <param name="b2">8.0e-6</param>
            <param name="c2">2.0e-6</param>        <!-- Coulomb friction, N m -->
            <param name="g">9.80665</param>

            <!-- Actuator limits -->
            <param name="motor_position_limit">2.35619449</param>  <!-- ±135° -->
            <param name="motor_max_velocity">7.0</param>
            <param name="motor_max_acceleration">200.0</param>
            <param name="motor_max_torque">0.6</param>
            <param name="model_step_loss">false</param>
            <param name="hard_stop_restitution">0.0</param>

            <!-- Sensors -->
            <param name="motor_steps_per_rev">3200</param>
            <param name="encoder_counts_per_rev">4096</param>
            <param name="encoder_noise">0.000</param>
            <param name="pendulum_velocity_from_encoder">false</param>
            <param name="velocity_filter_alpha">0.99</param>
            <param name="pendulum_report_offset">0.0</param>

            <!-- Randomness -->
            <param name="pendulum_accel_noise">0.0</param>
            <param name="motor_accel_noise">0.0</param>
            <param name="param_randomization">0.0</param>
            <param name="initial_q2">3.14159265</param>   <!-- hanging -->
            <param name="initial_q2_jitter">0.0</param>
            <param name="seed">0</param>                  <!-- 0 = nondeterministic -->

            <!-- Timing and visualisation -->
            <param name="sim_speed_factor">1.0</param>
            <param name="max_substep">5.0e-4</param>
            <param name="visualize">true</param>
        </hardware>
        <joint name="motor_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="acceleration"/>
        </joint>
        <joint name="pendulum_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>
