mainmenu "Zenoh E2E Test"

source "Kconfig.zephyr"

menu "Zenoh E2E Test Configuration"

config ZENOH_E2E_INGRESS
    bool "Enable host-to-firmware test traffic"
    default n
    depends on ZENOH_PICO
    select ZENOH_PICO_SUBSCRIPTION

config ZENOH_E2E_EGRESS
    bool "Enable firmware-to-host test traffic"
    default n
    depends on ZENOH_PICO
    select ZENOH_PICO_PUBLICATION

config ZENOH_E2E_PERIOD_MS
    int "Firmware egress publication period in milliseconds"
    default 1000
    range 1 60000

config ZENOH_E2E_DYNAMIC_PORT_OVERRIDE
    bool "Enable runtime dynamic Zenoh port override from environment"
    default n
    depends on ARCH_POSIX
    help
      When enabled, reads ZENBEDDED_ZENOH_PORT at runtime via getenv() to override the
      target endpoint.
      When disabled (default), the static ENDPOINT is used.

endmenu
